# ---------------------------------------------------------------------------
# Zomboid-Web sync backend configuration.
# Copy to `.env` and fill in. This file is safe to commit; `.env` is NOT.
# ---------------------------------------------------------------------------

# HTTP port the backend listens on (also serves the static editor). The app
# binds to 127.0.0.1 only — it's meant to be reached through a Cloudflare
# Tunnel running on this same box, not directly.
PORT=8934

# --- Cloudflare Access (gates everything under /api) ------------------------
# Protect this app's /api routes with a Cloudflare Access application (Zero
# Trust dashboard) scoped to your hostname's /api path, with a policy that
# allow-lists the emails of people you trust to use sync. Then set both of
# these so the backend verifies Access's JWT on every /api request:
#   CF_ACCESS_TEAM_DOMAIN — your team domain, e.g. yourteam.cloudflareaccess.com
#   CF_ACCESS_AUD         — the Application Audience (AUD) tag, from the
#                           Access application's Overview page.
# If either is left unset, JWT verification is skipped (logged once) — handy
# for local development, but do NOT deploy publicly without both set.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- SSH access to the machine running the PZ dedicated server ---------------
SSH_HOST=your.server.example.com
SSH_PORT=22
SSH_USER=zomboid
# Use ONE of the following auth methods:
SSH_KEY_PATH=/home/you/.ssh/id_ed25519
# SSH_KEY_PASSPHRASE=
# SSH_PASSWORD=

# Absolute path (recommended) to the server's SandboxVars file on the PZ host.
# Typically: <user home>/Zomboid/Server/<servername>_SandboxVars.lua
# A leading ~/ is expanded to the SSH user's home for SFTP.
PZ_SANDBOXVARS_PATH=~/Zomboid/Server/servertest_SandboxVars.lua

# Shell commands (run over SSH) that stop and start the server.
# Examples: systemd user unit, systemd system unit (needs sudo), screen, tmux, docker.
PZ_STOP_CMD=systemctl --user stop zomboid
PZ_START_CMD=systemctl --user start zomboid
# If PZ_STOP_CMD is empty, the backend stops the server with an RCON `quit` instead.

# Shell command (run over SSH) that prints the PZ server process's uptime in
# seconds to stdout, used by the status panel. Example for a systemd unit:
#   PZ_UPTIME_CMD=echo $(( $(date +%s) - $(systemctl --user show zomboid -p ExecMainStartTimestamp --value | xargs -I{} date -d {} +%s) ))
# If left empty, falls back to `ps -o etimes=` on the first process matching
# ProjectZomboid/start-server/zomboid — good enough for most setups.
PZ_UPTIME_CMD=

# Absolute path (recommended) to the server's Logs directory on the PZ host,
# used by the Logs tab: it lists the individual log files at the top level of
# this directory (admin/chat/cmd/user/etc — NOT the rotated `logs_MM-DD`
# subfolders) and lets you pick one to tail live over SSH. A leading ~/ is
# expanded to the SSH user's home. Leave empty to disable the Logs tab.
# Typically: <user home>/Zomboid/Logs
PZ_LOGS_DIR=

# --- RCON (used for player warnings, save, and up/down health checks) --------
RCON_HOST=127.0.0.1
RCON_PORT=27015
RCON_PASSWORD=changeme

# --- Restart behaviour -------------------------------------------------------
# Seconds of in-game countdown broadcast before the restart (mode: warn->countdown->restart).
RESTART_COUNTDOWN_SECONDS=60

# --- Backups -----------------------------------------------------------------
# Remote directory for timestamped backups of the previous SandboxVars file.
# A leading ~/ is expanded by the remote shell. Defaults to a `sandboxvars-backups`
# folder next to the file if left empty.
BACKUP_DIR=
# How many backups to keep (older ones are pruned).
BACKUP_KEEP=10

# --- Safety ------------------------------------------------------------------
# Set to 1 to log every push step WITHOUT writing files or restarting the server.
DRY_RUN=0
