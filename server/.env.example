# ---------------------------------------------------------------------------
# Zomboid-Web sync backend configuration.
# Copy to `.env` and fill in. This file is safe to commit; `.env` is NOT.
# ---------------------------------------------------------------------------

# HTTP port the backend listens on (also serves the static editor).
PORT=8934

# --- SSH access to the machine running the PZ dedicated server ---------------
SSH_HOST=your.server.example.com
SSH_PORT=22
SSH_USER=zomboid
# Use ONE of the following auth methods:
SSH_KEY_PATH=/home/you/.ssh/id_ed25519
# SSH_KEY_PASSPHRASE=
# SSH_PASSWORD=

# Absolute path (recommended) to the server's SandboxVars file on the PZ host.
# Typically: <user home>/Zomboid/Server/<servername>_SandboxVars.lua
# A leading ~/ is expanded to the SSH user's home for SFTP.
PZ_SANDBOXVARS_PATH=~/Zomboid/Server/servertest_SandboxVars.lua

# Shell commands (run over SSH) that stop and start the server.
# Examples: systemd user unit, systemd system unit (needs sudo), screen, tmux, docker.
PZ_STOP_CMD=systemctl --user stop zomboid
PZ_START_CMD=systemctl --user start zomboid
# If PZ_STOP_CMD is empty, the backend stops the server with an RCON `quit` instead.

# --- RCON (used for player warnings, save, and up/down health checks) --------
RCON_HOST=127.0.0.1
RCON_PORT=27015
RCON_PASSWORD=changeme

# --- Restart behaviour -------------------------------------------------------
# Seconds of in-game countdown broadcast before the restart (mode: warn->countdown->restart).
RESTART_COUNTDOWN_SECONDS=60

# --- Backups -----------------------------------------------------------------
# Remote directory for timestamped backups of the previous SandboxVars file.
# A leading ~/ is expanded by the remote shell. Defaults to a `sandboxvars-backups`
# folder next to the file if left empty.
BACKUP_DIR=
# How many backups to keep (older ones are pruned).
BACKUP_KEEP=10

# --- Safety ------------------------------------------------------------------
# Set to 1 to log every push step WITHOUT writing files or restarting the server.
DRY_RUN=0
