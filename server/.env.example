# ---------------------------------------------------------------------------
# Zomboid-Web sync backend configuration.
# Copy to `.env` and fill in. This file is safe to commit; `.env` is NOT.
# ---------------------------------------------------------------------------

# HTTP port the backend listens on (also serves the static editor). The app
# binds to 127.0.0.1 only — it's meant to be reached through a Cloudflare
# Tunnel running on this same box, not directly.
PORT=8934

# --- Cloudflare Access (gates everything under /api) ------------------------
# Protect this app's /api routes with a Cloudflare Access application (Zero
# Trust dashboard) scoped to your hostname's /api path, with a policy that
# allow-lists the emails of people you trust to use sync. Then set both of
# these so the backend verifies Access's JWT on every /api request:
#   CF_ACCESS_TEAM_DOMAIN — your team domain, e.g. yourteam.cloudflareaccess.com
#   CF_ACCESS_AUD         — the Application Audience (AUD) tag, from the
#                           Access application's Overview page.
# If either is left unset, JWT verification is skipped (logged once) — handy
# for local development, but do NOT deploy publicly without both set.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# ---------------------------------------------------------------------------
# Note: there is no server-wide SSH/RCON/SandboxVars configuration here
# anymore. Each sync request carries its own connection profile (SSH host,
# key or password, SandboxVars path, stop/start commands, RCON, countdown,
# backups, dry-run) in its request body — built client-side from that
# browser's own "Server settings" and never persisted by this backend. This
# is what lets multiple logged-in users sync against their own servers
# without exposing (or this backend ever storing) each other's credentials.
#
# Reference — fields a "server" profile carries (see index.html's Server
# settings modal / app.js's server-sync section):
#   sshHost, sshPort, sshUser, sshPrivateKey, sshKeyPassphrase, sshPassword
#   sandboxVarsPath           (leading ~/ expands to the SSH user's home)
#   stopCmd, startCmd         (shell commands run over SSH; empty stopCmd
#                              falls back to an RCON `quit`)
#   rconHost, rconPort, rconPassword
#   countdown                 (seconds of in-game warning before restart)
#   backupDir, backupKeep     (remote backup folder + how many to retain)
#   dryRun                    (log every push step without writing/restarting)
